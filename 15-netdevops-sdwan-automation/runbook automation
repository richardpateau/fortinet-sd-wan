config system accprofile
    edit "SDWAN-API-Profile"
        set comments "NetDevOps API profile for SD-WAN provisioning"
        set secfabgrp none
        set ftviewgrp read
        set authgrp none
        set sysgrp read-write
        set netgrp read-write
        set loggrp read
        set fwgrp read-write
        set vpngrp read-write
        set utmgrp none
        set wanoptgrp none
        set wifi none
    next
end

config system api-user
    edit "sdwan-automation"
        set accprofile "SDWAN-API-Profile"
        set vdom "root"
        config trusthost
            edit 1
                set ipv4-trusthost 0.0.0.0 0.0.0.0
            next
        end
    next
end

execute api-user generate-key sdwan-automation

config system interface
    edit "port1"
        append allowaccess https
    next
end

