BRANCH

config router community-list
    edit COMM-HIGH-PRIO
        config rule
            edit 1
                set action permit
                set match "65000:100"
            next
        end
    next
end

config router route-map
    edit "SET-ROUTE-TAG-IN"
        config rule
            edit 1
                set match-community "COMM-HIGH-PRIO"
                set set-route-tag 100
            next
            edit 2
                # Permit remaining routes untouched
            next
        end
    next
end

config router bgp
    config neighbor
        edit 10.255.1.254
            set send-community both
            set route-map-in "SET-ROUTE-TAG-IN"
        next
        edit 10.255.2.254
            set send-community both
            set route-map-in "SET-ROUTE-TAG-IN"
        next
    end
end

-----------------------

config system sdwan
    config service
        edit 0
            set name "Steer-Tag-100-MPLS"
            set mode manual
            set route-tag 100
            set priority-members 3
        next
    end
end
