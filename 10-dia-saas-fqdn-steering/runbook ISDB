config firewall address
    edit "Cloud-SaaS-FQDN"
        set type fqdn
        set fqdn "one.one.one.one"
        set cache-ttl 30
    next
    edit "networking-blog"
        set type fqdn
        set fqdn "networkingnotebook.com"
        set cache-ttl 30
    next
    edit "Cloud-Public-IP"
        set subnet 1.1.1.1 255.255.255.255
    next
    edit "Google-DNS-IP"
        set subnet 8.8.8.8 255.255.255.255
    next
end
---------------------------------------------

config system sdwan
    config service
        edit 0
            set name "SaaS-Cloud-DIA"
            set mode manual
            set internet-service disable
            set dst "Cloud-SaaS-FQDN" "Cloud-Public-IP" "Google-DNS-IP" "networking-blog"
            set priority-members 2
        next
        edit 0
            set name "Corporate-Backhaul"
            set mode manual
            set dst "all"
            set priority-members 3
        next
    end
end

----------------------------------------------

config firewall policy
    edit 30
        set name "SaaS-DIA-Local-Out"
        set srcintf port1
        set dstintf virtual-wan-link
        set srcaddr "all"
        set dstaddr "all"
        set action accept
        set schedule "always"
        set service "ALL"
        set nat enable
    next
    edit 31
        set name "Corp-Backhaul-To-HQ"
        set srcintf "port1"
        set dstintf "VPN-ZONE"
        set srcaddr "all"
        set dstaddr "all"
        set action accept
        set schedule "always"
        set service "ALL"
        set nat disable
    next
end

---------------------------------------------
