config system sdwan
    config health-check
        edit "ADVPN_HEALTH"
            set server "10.10.10.1"
            set members 3 4
            set interval 1000
            set failtime 3
            set recoverytime 5
            config sla
                edit 1
                    set latency-threshold 150
                    set jitter-threshold 30
                    set packetloss-threshold 2
                next
            end
        next
    end
    config neighbor
        edit "10.255.1.254"
            set member 3
            set health-check "ADVPN_HEALTH"
            set sla-id 1
        next
        edit "10.255.2.254"
            set member 4
            set health-check "ADVPN_HEALTH"
            set sla-id 1
        next
    end
end

---------------------------------

config router route-map
    edit "MED-MPLS-IN-SLA"
        config rule
            edit 1
                set set-metric 100
            next
        end
    next
    edit "MED-BB-IN-SLA"
        config rule
            edit 1
                set set-metric 200
            next
        end
    next
    edit "MED-OUT-OF-SLA"
        config rule
            edit 1
                set set-metric 500
            next
        end
    next
end

------------------------------

config router bgp
    config neighbor
        edit "10.255.1.254"
            set route-map-out-preferable "MED-MPLS-IN-SLA"
            set route-map-out "MED-OUT-OF-SLA"
        next
        edit "10.255.2.254"
            set route-map-out-preferable "MED-BB-IN-SLA"
            set route-map-out "MED-OUT-OF-SLA"
        next
    end
end

