BRANCH 1

config system sdwan
    set duplication-max-num 2
    config duplication
        edit 1
            set srcintf "port1"
            set dstintf VPN-ZONE
            set srcaddr "BRANCH-1-LAN"
            set dstaddr "HQ-LAN"
            set service "ALL"
            set packet-duplication force
            set packet-de-duplication enable
        next
    end
end


